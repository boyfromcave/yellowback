# Nested clones — each is its own git repo, managed independently.
# Pins are recorded in AGENTS.md and docs/mapping.md.
/ref/
/ycash-dd/
/yecwallet-dd/
/lightwalletd-dd/
/yew/

# macOS
.DS_Store

# Personal, machine-local Claude Code settings (attribution off).
# Team-wide settings would go in .claude/settings.json instead.
/.claude/settings.local.json

# Python virtual environment for the workspace (never install into the system Python).
/.venv/

# git worktrees of the forks, used by parallel agent sessions (created with `git -C ycash-dd worktree add ../wt/<name>`).
/wt/
